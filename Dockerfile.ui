# syntax=docker/dockerfile:1.7
# The UI image (proposal 009): Streamlit + requests only. No noterecall package, no torch, no
# onnxruntime, no notes, no index.
ARG PY=python:3.12-slim

FROM ${PY} AS deps
RUN pip install --no-cache-dir uv==0.11.32
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-hashes --no-emit-project --only-group ui-image -o /tmp/req.txt \
 && python -m venv /venv && /venv/bin/pip install --no-cache-dir -r /tmp/req.txt

FROM ${PY}
RUN useradd --create-home app
WORKDIR /app
COPY --from=deps /venv /venv
COPY app/streamlit_app.py ./streamlit_app.py
ENV PATH=/venv/bin:$PATH PYTHONUNBUFFERED=1
USER app
EXPOSE 8501
CMD ["sh", "-c", "streamlit run streamlit_app.py --server.address 0.0.0.0 --server.port ${PORT:-8501} --server.headless true --browser.gatherUsageStats false"]
